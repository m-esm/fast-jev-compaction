{
  "name": "fast-jev-compaction",
  "version": "0.6.3",
  "description": "Continuous, verbatim context compaction for LLM agents using TypeSafe's Jev model, with PII masking before anything leaves the machine.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && npm run typecheck:hooks && npm run typecheck:replay",
    "test": "vitest run",
    "demo": "tsx examples/demo.ts",
    "report": "node scripts/report.mjs",
    "replay": "tsx scripts/replay.ts",
    "typecheck:hooks": "tsc -p tsconfig.hooks.json",
    "typecheck:replay": "tsc --noEmit --target es2022 --module nodenext --strict --skipLibCheck scripts/replay.ts types/claude-code.d.ts",
    "validate:plugin": "claude plugin validate .claude-plugin/plugin.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
